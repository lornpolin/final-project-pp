# Copy this file to `.env` and adjust the values.

SECRET_KEY=change-me-to-a-long-random-string
SHOP_NAME=PP Shop
CURRENCY=USD                 # USD or KHR

# ── Database ──────────────────────────────────────────────────
# Leave commented out for local SQLite (instance/shop.db),
# or paste your Neon PostgreSQL URL (must include ?sslmode=require):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ── Initial Admin Account (seeded on first run) ───────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# ── Cloudinary (optional – persistent image hosting for Render) ─
# Leave empty to store images locally under uploads/products/.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_FOLDER=pp_shop/products

# ── KHQR / Bakong ─────────────────────────────────────────────
# Your Bakong account ID as shown in the Bakong app (format: name@bank)
BAKONG_ACCOUNT_ID=ppshop@aclb
KHQR_MERCHANT_NAME=PP Shop
KHQR_MERCHANT_CITY=Phnom Penh
KHQR_MOBILE_NUMBER=
KHQR_EXPIRE_MINUTES=15

# Optional – Bakong Open API token (register at https://api-bakong.nbc.gov.kh).
# When set, payments are verified automatically and demo mode is disabled.
BAKONG_API_TOKEN=
# KHQR_DEMO_MODE=true        # force the "simulate payment" button on/off
